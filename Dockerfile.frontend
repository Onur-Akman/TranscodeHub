# Stage 1: Build Angular app
FROM node:20 AS builder
WORKDIR /app
# Copy only package.json — skip package-lock.json so npm generates
# a fresh lockfile with correct platform-specific optional deps (rollup, esbuild)
# This works around https://github.com/npm/cli/issues/4828
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ .
RUN npx ng build --configuration production

# Stage 2: Serve with Nginx + RTMP
FROM alpine:latest
RUN apk add --no-cache nginx nginx-mod-rtmp && \
    mkdir -p /usr/share/nginx/html && \
    mkdir -p /run/nginx && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

EXPOSE 80 1935

CMD ["nginx", "-g", "daemon off;"]
